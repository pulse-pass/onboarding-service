API_PORT=8081

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=onboarding
MYSQL_USER=onboarding
MYSQL_PASSWORD=onboarding
MYSQL_PORT=3307

MOCKSERVER_PORT=1081

INTERNAL_TOKEN=pulse-pass-internal-token

KEYCLOAK_REALM=pulse-pass
KEYCLOAK_CLIENT_ID=onboarding-service
KEYCLOAK_CLIENT_SECRET=onboarding-service-development-secret

# External dependency URLs. service-start.sh picks one of the pair according to the mode
# (test or development) and exports it as <NAME>_URL for docker compose. Every future external
# dependency follows the same pattern: <NAME>_TEST_URL and <NAME>_DEVELOPMENT_URL.
KEYCLOAK_TEST_URL=http://onboarding-service-mockserver:1080
KEYCLOAK_DEVELOPMENT_URL=http://pulse-pass-keycloak:8080
ORGANIZATION_SERVICE_TEST_URL=http://onboarding-service-mockserver:1080
ORGANIZATION_SERVICE_DEVELOPMENT_URL=http://organization-service-api:8080
